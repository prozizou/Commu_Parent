# Firebase — projet "scolar-hub"
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# À ajouter séparément dans Vercel, ne fait pas partie des 6 variables standards
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Resend (envoi d'emails, utilisé côté Cloud Functions uniquement)
RESEND_API_KEY=

# Firebase Admin (route /admin/create-parent, jamais exposé au client)
# Valeurs à copier depuis le fichier serviceAccountKey.json téléchargé sur Firebase Console
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Code secret que tu choisis toi-même, à saisir dans le formulaire /admin/create-parent
ADMIN_API_SECRET=
