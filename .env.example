# Firebase — projet "scolar-hub"
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# À ajouter séparément dans Vercel, ne fait pas partie des 6 variables standards
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Resend (envoi d'emails, utilisé côté Cloud Functions uniquement)
RESEND_API_KEY=

# Firebase Admin (routes /api/admin/*, jamais exposé au client)
# Valeurs à copier depuis le fichier serviceAccountKey.json téléchargé sur Firebase Console
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Code secret que tu choisis toi-même, utilisé UNE SEULE FOIS dans /admin/create-staff
# pour créer le tout premier compte Super Admin (voir README > "Super Admin"). Une fois ce
# compte créé, toutes les autres routes /api/admin/* exigent une vraie session Super Admin
# (email + mot de passe via /admin/login) — ce code ne leur sert plus.
ADMIN_API_SECRET=
