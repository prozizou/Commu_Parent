{
  "rules": {
    "parents": {
      "$parentId": {
        // Un parent ne peut lire/écrire que sa propre fiche.
        // Le staff (custom claim staff=true) peut tout lire pour gérer les familles.
        ".read": "auth != null && (auth.token.parentId === $parentId || auth.token.staff === true)",
        ".write": "auth != null && auth.token.staff === true"
      }
    },
    "students": {
      "$studentId": {
        ".read": "auth != null && (auth.token.staff === true || (data.child('parentIds').child(auth.token.parentId).exists()))",
        ".write": "auth != null && auth.token.staff === true"
      }
    },
    "messages": {
      "$threadId": {
        // threadId format recommandé : "<studentId>_<parentId>" pour isoler chaque famille
        ".read": "auth != null && (auth.token.staff === true || $threadId.contains(auth.token.parentId))",
        ".write": "auth != null && (auth.token.staff === true || $threadId.contains(auth.token.parentId))"
      }
    },
    "notifications": {
      "$parentId": {
        ".read": "auth != null && (auth.token.parentId === $parentId || auth.token.staff === true)",
        ".write": "auth != null && auth.token.staff === true",
        "$notifId": {
          "lu": {
            // Le parent peut marquer ses propres notifs comme lues, rien d'autre.
            ".write": "auth != null && auth.token.parentId === $parentId"
          }
        }
      }
    },
    "schools": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.staff === true"
    },
    "evaluations": {
      "$studentId": {
        // Même logique d'accès que students/$studentId : le staff voit tout,
        // un parent ne voit que les évaluations de ses propres enfants.
        ".read": "auth != null && (auth.token.staff === true || root.child('students').child($studentId).child('parentIds').child(auth.token.parentId).exists())",
        ".write": "auth != null && auth.token.staff === true",
        // Requis par la requête orderByChild("createdAt") utilisée sur
        // /performance/[studentId] (tri chronologique des évaluations d'un élève).
        ".indexOn": "createdAt"
      }
    },
    "groups": {
      "$groupId": {
        // Groupes/classes utilisés pour les moyennes de comparaison (section "groupe").
        // Réservé au staff : les parents lisent les moyennes via evaluations/comparaisons, pas ce noeud.
        ".read": "auth != null && auth.token.staff === true",
        ".write": "auth != null && auth.token.staff === true"
      }
    },
    "staff": {
      "$uid": {
        // Une fiche staff (admin/professeur) est lisible par son titulaire et par tout le staff.
        // Écriture réservée au Super Admin : seul un rôle "admin" peut créer/modifier des comptes staff.
        ".read": "auth != null && (auth.uid === $uid || auth.token.staff === true)",
        ".write": "auth != null && auth.token.staff === true && auth.token.role === 'admin'"
      }
    }
  }
}
